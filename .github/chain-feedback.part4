al feedback")

old_tail = "state.protonCaptureAttempts[key]=0;ensureProtonCaptureFuel(s.mode==='protonCapture'?3:(rpStep(s)?.fuel==='p'?4:1));state.selected=[];state.locked=false;render();checkComplete();"
new_tail = "state.protonCaptureAttempts[key]=0;ensureProtonCaptureFuel(s.mode==='protonCapture'?3:(rpStep(s)?.fuel==='p'?4:1));state.selected=[];state.locked=false;render();checkComplete();if(!pieceIsUnstable(target))scheduleAutoProtonCascade(target.id,chainRoot,chainDepth);"
js = once(js, old_tail, new_tail, "rp final cascade continuation")

# Gamma / spallation products can feed a learned adjacent fusion after the energetic event.
old_cosmic_product = "const product=createPiece(out,cell,false);product.x=x;product.y=y;product.newborn=true;focusPieceInfo(product);"
new_cosmic_product = "const chainRoot=startChainEvent(s.mode==='gamma'?'gamma':s.mode==='spallation'?'nuclear':'reaction',x,y),product=createPiece(out,cell,false);product.x=x;product.y=y;product.chainRoot=chainRoot;product.chainDepth=1;product.newborn=true;focusPieceInfo(product);"
js = once(js, old_cosmic_product, new_cosmic_product, "cosmic product provenance")
old_cosmic_tail = "await afterNuclearAction();state.locked=false;render();checkComplete();if(!state.phaseDone)setTimeout(spawnCosmicRay,120)"
new_cosmic_tail = "await afterNuclearAction();state.locked=false;render();checkComplete();scheduleAutoFusionCascade(product.id,chainRoot,1,s.mode==='gamma'?'gamma':'nuclear');if(!state.phaseDone)setTimeout(spawnCosmicRay,120)"
# This tail appears in the non-isotope branch once; isotope branch has an earlier return.
js = once(js, old_cosmic_tail, new_cosmic_tail, "cosmic chain continuation")

css_add = r'''
/* Reaction feedback + stellar resonance. The star carries the reward state so the
   HUD stays focused on scientific objective and phase PROGRESS. */
.star-board.chain-resonance::after{content:"";position:absolute;inset:-5%;z-index:2;pointer-events:none;border-radius:50%;opacity:calc(var(--resonanceGlow,0)*.78);background:radial-gradient(circle,transparent 48%,rgba(255,246,190,.10) 61%,rgba(150,222,255,.30) 77%,transparent 92%);box-shadow:0 0 calc(18px + var(--resonanceGlow,0)*50px) rgba(171,226,255,.48);mix-blend-mode:screen;transition:opacity .38s ease,filter .38s ease;filter:brightness(calc(1 + var(--resonanceGlow,0)*.45))}
.star-board.reaction-reward{animation:reactionReward .32s ease-out}.star-board.reaction-reward-strong{animation:reactionRewardStrong .50s ease-out}
@keyframes reactionReward{0%{transform:scale(var(--starScale));filter:brightness(1)}45%{transform:scale(calc(var(--starScale)*1.018));filter:brightness(1.18)}100%{transform:scale(var(--starScale));filter:brightness(1)}}
@keyframes reactionRewardStrong{0%{transform:scale(var(--starScale));filter:brightness(1)}38%{transform:scale(calc(var(--starScale)*1.035));filter:brightness(1.42) drop-shadow(0 0 48px rgba(185,232,255,.60))}100%{transform:scale(var(--starScale));filter:brightness(1)}}
'''
if '/* Reaction feedback + stellar resonance.' in css:
    raise SystemExit('CSS feedback block already present')
css += '\n' + css_add

required_js = [
    "const CHAIN_AUTO_FLOW_FACTORS=Object.freeze([.25,.10,0])",
    "const CHAIN_MAX_PROGRESS_BONUS=.10",
    "const CHAIN_OBJECTIVE_PROGRESS_FLOOR=.75",
    "function scheduleAutoFusionCascade",
    "function scheduleNeutronCascade",
    "function scheduleAutoProtonCascade",
    "function captureTag(x,y,text){if(!dom.fx",
    "if(objectiveDone&&objectiveFlowFloorApplies(s))",
    "scheduleNeutronCascade(chainRoot,emitted)",
    "scheduleAutoProtonCascade(target.id,chainRoot,chainDepth)",
]
for marker in required_js:
    if marker not in js:
        raise SystemExit(f'missing JS marker: {marker}')
required_css = ['.star-board.chain-resonance::after','.star-board.reaction-reward-strong','@keyframes reactionRewardStrong']
for marker in required_css:
    if marker not in css:
        raise SystemExit(f'missing CSS marker: {marker}')

js_path.write_text(js)
css_path.write_text(css)
